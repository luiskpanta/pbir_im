	column EsRemoto =
			
			IF(
			    'con_indice_de_ocupacion'[TipoServicio] = "04 SOPORTE REMOTO",
			    1,
			    0
			)
		formatString: 0
		lineageTag: 18f1d3d3-5cbc-41ec-83ce-2423c86e0557
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EsCorrectivo =
			IF(
			    OR(
			    'con_indice_de_ocupacion'[TipoServicio] = "04 SOPORTE REMOTO", 'con_indice_de_ocupacion'[TipoServicio] = "02 CORRECTIVO"),
			    1,
			    0
			)
		formatString: 0
		lineageTag: a48cda03-25ea-48b5-afbb-239a91a2664b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EsCargo =
			
			IF('con_indice_de_ocupacion'[cargo] = "APLICACIONISTA",
			    2,
			    10
			)
		formatString: 0
		lineageTag: 8669859e-450d-45d3-bab4-055da16e1bb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

