table con_indice_de_ocupacion
	lineageTag: 5fe143c7-10d8-4d6b-8e6b-2d06e349cf9e

	measure %Ocupación =
			
			DIVIDE(
			    SUM('con_indice_de_ocupacion'[duracion]),
			    con_indice_de_ocupacion[estandarmes]
			)
		lineageTag: 1ac7653f-6114-476c-a100-86c71e17fc03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %Remoto = ```
			
			DIVIDE(
			    SUM('con_indice_de_ocupacion'[EsRemoto]), 
			    SUM('con_indice_de_ocupacion'[EsCorrectivo]),
			    0)
			```
		lineageTag: 7d8e7732-c2f7-4e70-8b66-fd82b767f0c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %Abiertas =
			
			DIVIDE(
			    SUM('con_indice_de_ocupacion'[abierta]),
			    COUNT('con_indice_de_ocupacion'[id]),
			    0)
		lineageTag: 2de5307a-3edb-4000-9a3c-d304824c02b2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %Remoto_cerrado =
			
			DIVIDE(
			    CALCULATE(SUM('con_indice_de_ocupacion'[EsRemoto]), con_indice_de_ocupacion[estadoOT]="Cerrada"),
			    SUM('con_indice_de_ocupacion'[EsRemoto]),
			    0)
		lineageTag: c91bed9e-38b1-4153-827e-de0ec7dbd236

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PromTiempoRemoto =
			
			CALCULATE(AVERAGE('con_indice_de_ocupacion'[duracion]), 'con_indice_de_ocupacion'[EsRemoto]=1, con_indice_de_ocupacion[estadoOT]="Cerrada")
		lineageTag: cc811bf0-718c-466e-936f-7fd3acae5564

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure estandarmes =
			114.166*
			DISTINCTCOUNT(Dim_Fecha[Mes])*
			AVERAGE(con_indice_de_ocupacion[EsCargo])
		lineageTag: 9afcbb81-2a72-457a-9d35-ec0c1e78dbb3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

