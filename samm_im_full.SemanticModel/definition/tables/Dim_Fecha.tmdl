	column Recientes =
			SWITCH(
				TRUE,
				ISBLANK('Dim_Fecha'[Año]),
				"(En blanco)",
				'Dim_Fecha'[Año] IN {2024,
					2025,
					2026},
				"2024 & 2025 & 2026",
				"Otros"
			)
		lineageTag: c2a7bf58-15c8-48bf-9286-f3af64898f9d
		summarizeBy: none

