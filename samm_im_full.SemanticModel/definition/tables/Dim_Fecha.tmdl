				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"d","Entity":"Dim_Fecha"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Año"}}],"GroupItems":[{"DisplayName":"(En blanco)","BlankDefaultPlaceholder":true},{"DisplayName":"2024 & 2025 & 2026","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"d"}},"Property":"Año"}}],"Values":[[{"Literal":{"Value":"2024L"}}],[{"Literal":{"Value":"2025L"}}],[{"Literal":{"Value":"2026L"}}]]}}},{"DisplayName":"Otros"}]}

		annotation SummarizationSetBy = Automatic

	partition Dim_Fecha = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2020, 1, 1), 
				        DATE(2030, 12, 31)
				    ),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "MesNúmero", MONTH([Date]),
				    "Año-Mes", FORMAT([Date], "YYYY-MM")
				)
				```

	annotation PBI_Id = 175aa3c7b0584773959227b9c69ba73b

