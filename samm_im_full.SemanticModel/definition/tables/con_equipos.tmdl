table con_equipos
	lineageTag: def03de1-1667-48fb-84b5-2a8e198981a9

	measure 'Recuento de equipo_serial para Inactivo' =
			
			CALCULATE(
				COUNTA('con_equipos'[equipo_serial]),
				'con_equipos'[estadoEquipo] IN { "Inactivo" }
			)
		formatString: 0
		lineageTag: a313024c-ffe8-48f6-a35d-7d968d258a11

