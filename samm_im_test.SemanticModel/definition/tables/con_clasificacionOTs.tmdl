	column Reciente =
			if( YEAR(con_clasificacionOTs[fecha_DOC])= YEAR(TODAY()),1,
			if( YEAR(con_clasificacionOTs[fecha_DOC])= YEAR(TODAY())-1,1,
			if( YEAR(con_clasificacionOTs[fecha_DOC])= YEAR(TODAY())-2,1,0)))
		formatString: 0
		lineageTag: 98f21f3a-df07-487d-a074-f5bb587614c8
		summarizeBy: average

		annotation SummarizationSetBy = User

	column 04Remoto =
			IF(
			    'con_clasificacionOTs'[tipoServicio] = "04 SOPORTE REMOTO",
			    1,
			    0
			)
		formatString: 0
		lineageTag: 0502311e-2e6b-49c7-8797-c72eeb572cb7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 0402Correctivo =
			IF(
			    OR(
			    'con_clasificacionOTs'[tipoServicio] = "04 SOPORTE REMOTO", 'con_clasificacionOTs'[tipoServicio] = "02 CORRECTIVO"),
			    1,
			    0)
		formatString: 0
		lineageTag: 35a389da-acff-472b-bd78-b44677139451
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

