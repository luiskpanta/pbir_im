table con_clasificacionOTs
	lineageTag: 07fe3770-e0eb-4c14-8a2c-5127e3b6ca3a

	measure %OTAbiertas = ```
			
			 DIVIDE(
			    SUM(con_clasificacionOTs[abierta]),
			    COUNT(con_clasificacionOTs[id])
			    )
			```
		lineageTag: baac5634-b3a7-4cdb-b9cd-2935b48050c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %EsRemoto = ```
			
			DIVIDE(
			    SUM('con_clasificacionOTs'[04Remoto]), 
			    SUM('con_clasificacionOTs'[0402Correctivo]),
			    0)
			```
		lineageTag: 3b4777ae-048d-44f9-8c8e-6ca936a06dfa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %OTCerradas = ```
			
			 1-DIVIDE(
			    SUM(con_clasificacionOTs[abierta]),
			    COUNT(con_clasificacionOTs[id])
			    )
			```
		lineageTag: e544e92b-4d0a-423b-acf3-87f79c0ddcdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %EfectREM =
			DIVIDE(
			    SUM(con_clasificacionOTs[si_Efectiva]),
			    SUM(con_clasificacionOTs[04Remoto])
			)
		lineageTag: d3094e6e-a1f8-409c-a909-daa33c91d516

		annotation PBI_FormatHint = {"isGeneralNumber":true}

