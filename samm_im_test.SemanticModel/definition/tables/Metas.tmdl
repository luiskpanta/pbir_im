	column 'RT Sitio'
		dataType: double
		lineageTag: 89F91973-1F15-46B8-B604-683D32741B21
		summarizeBy: none
		sourceColumn: RT Sitio

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Metas = m
		mode: import
		source =
				let
				    Origen = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1GE1gPbQNrcap7dwGmaI8tRY2R9cVzCKPsoi03CCd6Bk/edit?gid=1247000452#gid=1247000452"),
				    Metas_Table = Origen{[name="Metas",ItemKind="Table"]}[Data],
				    EsGenerico = List.AnyTrue(List.Transform(Table.ColumnNames(Metas_Table), each Text.StartsWith(_, "Column"))),
				    ConEncabezados = if EsGenerico then Table.PromoteHeaders(Metas_Table, [PromoteAllScalars=true]) else Metas_Table,
				    NombresLimpios = Table.TransformColumnNames(ConEncabezados, Text.Trim),
				    Efectividad = Table.TransformColumns(NombresLimpios, {{"Efectividad Remota", each Number.FromText(Text.Replace(Text.Trim(Text.From(_)), "%", "")) / 100, type number}}),
				    ConMTTR = if Table.HasColumns(Efectividad, "MTTR SP") then Table.TransformColumns(Efectividad, {{"MTTR SP", each try Number.FromText(Text.Trim(Text.From(_))) otherwise null, type number}}) else Table.AddColumn(Efectividad, "MTTR SP", each null, type number),
				    ConRT = if Table.HasColumns(ConMTTR, "RT Remoto") then Table.TransformColumns(ConMTTR, {{"RT Remoto", each try Number.FromText(Text.Trim(Text.From(_))) otherwise null, type number}}) else Table.AddColumn(ConMTTR, "RT Remoto", each null, type number),
				    ConSitio = if Table.HasColumns(ConRT, "RT Sitio") then Table.TransformColumns(ConRT, {{"RT Sitio", each try Number.FromText(Text.Trim(Text.From(_))) otherwise null, type number}}) else Table.AddColumn(ConRT, "RT Sitio", each null, type number),
				    Tipos = Table.TransformColumnTypes(ConSitio, {{"MES", type text}, {"FAMILIA", type text}}),
				    Seleccion = Table.SelectColumns(Tipos, {"MES", "FAMILIA", "Efectividad Remota", "MTTR SP", "RT Remoto", "RT Sitio"})
				in
				    Seleccion

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

