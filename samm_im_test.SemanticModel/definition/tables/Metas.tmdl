table Metas
	lineageTag: 04944223-AD3E-49AC-ADDB-E92BF2B47A56

	measure 'Meta Efectividad Remota' = AVERAGE(Metas[Efectividad Remota])
		lineageTag: 8AB9852C-3518-433F-B646-7C3B35756D45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color Fondo Efectividad Remota' = IF ( [%EfectREM] < [Meta Efectividad Remota], "#FF0000", "#00B050" )
		lineageTag: 1886B266-7169-490E-B37C-FB0A562EF3F3

	measure 'Meta MTTR SP' = AVERAGE(Metas[MTTR SP])
		lineageTag: c45deea1-4d80-4266-b63d-29074b0808ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meta Response Time' = AVERAGE(Metas[RT Remoto])
		lineageTag: 64440A2E-AFD3-441F-84D7-5D8C0633C94D

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meta RT Sitio' = AVERAGE(Metas[RT Sitio])
		lineageTag: D0F0C0E6-F6A3-4721-AFC1-FA8954E50D1C

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color MTTR SP' = IF ( [MTTR Sin Partes (hrs)] <= [Meta MTTR SP], "#2E8B57", "#D64550" )
		lineageTag: b658fb04-9874-43e8-810a-a534b6df2225

	measure 'Etiqueta MTTR SP' = "MTTR SP (< " & FORMAT ( [Meta MTTR SP], "0.#" ) & " hrs)"
		lineageTag: 18cbab86-70ec-4cef-8973-17e0ec406ac5

