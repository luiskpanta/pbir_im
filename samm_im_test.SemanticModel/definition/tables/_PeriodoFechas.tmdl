table _PeriodoFechas
	lineageTag: 38166b56-d097-4287-ac06-977eb7e09947

	column Fecha
		dataType: dateTime
		formatString: General Date
		lineageTag: 304bae46-4eb9-4d81-a974-fedf20b340ed
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fecha]

		annotation SummarizationSetBy = Automatic

	column FechaPeriodo
		dataType: dateTime
		formatString: General Date
		lineageTag: 8423c2d2-ecaa-49ea-a094-1e2de5ff9c15
		summarizeBy: none
		isNameInferred
		sourceColumn: [FechaPeriodo]

		annotation SummarizationSetBy = Automatic

	column EsVentana4M =
			VAR MesCorte =
			    DATE ( YEAR ( '_PeriodoFechas'[Fecha] ), MONTH ( '_PeriodoFechas'[Fecha] ), 1 )
			VAR InicioVentana = EDATE ( MesCorte, -3 )
			VAR FinVentana = EDATE ( MesCorte, 1 )
			RETURN
			    IF (
			        '_PeriodoFechas'[FechaPeriodo] >= InicioVentana
			            && '_PeriodoFechas'[FechaPeriodo] < FinVentana,
			        1,
			        0
			    )
		dataType: int64
		formatString: 0
		lineageTag: 8b6342c2-1b19-4b23-9616-618a2ebc27d8
		summarizeBy: none

	column EsMesCorte =
			VAR MesCorte =
			    DATE ( YEAR ( '_PeriodoFechas'[Fecha] ), MONTH ( '_PeriodoFechas'[Fecha] ), 1 )
			VAR FinMes = EDATE ( MesCorte, 1 )
			RETURN
			    IF (
			        '_PeriodoFechas'[FechaPeriodo] >= MesCorte
			            && '_PeriodoFechas'[FechaPeriodo] < FinMes,
			        1,
			        0
			    )
		dataType: int64
		formatString: 0
		lineageTag: 57fc232a-cbac-43fc-a814-1b8bad335509
		summarizeBy: none

	partition _PeriodoFechas = calculated
		mode: import
		source =
				
				VAR Fin = TODAY () + 2
				VAR Inicio = TODAY () - 730
				VAR Cortes =
				    SELECTCOLUMNS (
				        CALENDAR ( Inicio, Fin ),
				        "FechaCorteKey", [Date]
				    )
				VAR Puente =
				    GENERATE (
				        Cortes,
				        SELECTCOLUMNS (
				            CALENDAR ( [FechaCorteKey] - 365, [FechaCorteKey] ),
				            "FechaPeriodo", [Date]
				        )
				    )
				RETURN
				    SELECTCOLUMNS (
				        Puente,
				        "Fecha", [FechaCorteKey],
				        "FechaPeriodo", [FechaPeriodo]
				    )

	annotation PBI_Id = 71fd43d46cb444bab3ddf5ae813cdbeb

