table con_equiposContrato
	lineageTag: b471f57d-081b-4494-9844-8aa10ae872b2

	measure CR = ```
			
			    DIVIDE(
				SUM('con_equiposContrato'[enContrato]),
				SUM('con_equiposContrato'[baseCR])
			)
			```
		lineageTag: 401212f3-0730-4fd8-b406-387f65b77d07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure WC =
			
			DIVIDE(
				SUM('con_equiposContrato'[paso_garantia_a_contrato]),
				SUM('con_equiposContrato'[enGarantia])
			)
		lineageTag: fd3ec759-3037-4250-8dea-fb06aacd41b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure WB =
			
			DIVIDE(
				SUM('con_equiposContrato'[paso_percall_evento_a_contrato]),
				SUM('con_equiposContrato'[enEvento_Percall])
			)
		lineageTag: 7d49ff8c-4e10-4d5a-a28e-eaf46f85904b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meta CR mes' = AVERAGE(con_equiposContrato[metaCR2])
		lineageTag: D9570E6D-081F-49F0-AD42-40B1D0B5049A

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meta WC mes' = AVERAGE(con_equiposContrato[MetWC])
		lineageTag: B85A3BDA-2972-48CD-BB95-875459586F41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Win back cant' = SUM(con_equiposContrato[paso_percall_evento_a_contrato])
		formatString: 0
		lineageTag: DB35DAB3-DA83-441D-ACFA-5A4EE76DA62C

	measure 'Mes actual' = CALCULATE(MAX(con_equiposContrato[mes]), ALLSELECTED(con_equiposContrato))
		formatString: Long Date
		lineageTag: 2ED2C39C-B343-4EA3-9561-A28A7C0478D5

	measure 'WC actual' = VAR m = [Mes actual] RETURN CALCULATE([WC], con_equiposContrato[mes] = m)
		lineageTag: 0A05AB6F-3143-46C0-9EC6-FA9515089B40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WC ant' = VAR m = EDATE([Mes actual], -1) RETURN CALCULATE([WC], con_equiposContrato[mes] = m)
		lineageTag: 2AC5F536-1AEA-4001-BD3E-07B0D559F2F8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var pp WC' = ([WC actual] - [WC ant]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: DE266BFB-AC70-41F6-A3C1-635258748817

	measure 'CR actual' = VAR m = [Mes actual] RETURN CALCULATE([CR], con_equiposContrato[mes] = m)
		lineageTag: 123A8658-1E2C-49D2-BBD7-436F39EB2532

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR ant' = VAR m = EDATE([Mes actual], -1) RETURN CALCULATE([CR], con_equiposContrato[mes] = m)
		lineageTag: 9B77F964-7858-4EA7-A34C-B3A66488451F

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var pp CR' = ([CR actual] - [CR ant]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: FC951835-8568-4F84-89E2-48F407D14A9F

	measure 'Win back actual' = VAR m = [Mes actual] RETURN CALCULATE([Win back cant], con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: 49CEFA02-83F0-4870-8B01-CD1D41ABD73F

	measure 'Win back ant' = VAR m = EDATE([Mes actual], -1) RETURN CALCULATE([Win back cant], con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: DF5EDEE1-414D-4A81-99B0-D07E395CCC23

	measure 'Var % Win back' = DIVIDE([Win back actual] - [Win back ant], [Win back ant])
		lineageTag: 169D9489-526C-416B-B4EA-CB88A32766FC

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Garantia mes actual' = VAR m = [Mes actual] RETURN CALCULATE(SUM(con_equiposContrato[enGarantia]), con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: E97B581B-7AE8-4E78-A8B7-B7122C638D77

	measure 'Contrato mes actual' = VAR m = [Mes actual] RETURN CALCULATE(SUM(con_equiposContrato[enContrato]), con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: BDFE6A84-2517-4DD2-A1BA-07022015BEA7

	measure 'Sin cobertura mes actual' = VAR m = [Mes actual] RETURN CALCULATE(COUNTROWS(con_equiposContrato) - SUM(con_equiposContrato[enGarantia]) - SUM(con_equiposContrato[enContrato]), con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: DC5FC0B0-EDCF-4890-BB4A-4332DCA01941

	measure 'Cobertura actual' = DIVIDE([Garantia mes actual] + [Contrato mes actual], [Garantia mes actual] + [Contrato mes actual] + [Sin cobertura mes actual])
		lineageTag: 1E443300-0EAD-4848-ACE1-18E217AC4930

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cobertura ant' = VAR m = EDATE([Mes actual], -1) VAR G = CALCULATE(SUM(con_equiposContrato[enGarantia]), con_equiposContrato[mes] = m) VAR C = CALCULATE(SUM(con_equiposContrato[enContrato]), con_equiposContrato[mes] = m) VAR T = CALCULATE(COUNTROWS(con_equiposContrato), con_equiposContrato[mes] = m) RETURN DIVIDE(G + C, T)
		lineageTag: 44D561B7-DF89-4BB4-BB23-A59994AC9A86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var pp Cobertura' = ([Cobertura actual] - [Cobertura ant]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: C55948DF-4EDD-4EDC-A03F-71804B06DD23

	measure 'Equipos mes actual' = VAR m = [Mes actual] RETURN CALCULATE(DISTINCTCOUNT(con_equiposContrato[equipo_serial]), con_equiposContrato[mes] = m)
		formatString: 0
		lineageTag: CF2264C6-B119-4FC9-8E81-035E026A9878

	measure 'Color Var WC' = IF([Var pp WC] >= 0, "#2E8B57", "#D64550")
		lineageTag: 768A6E9A-A874-49AC-9E78-4B14C155FC43

	measure 'Color Var CR' = IF([Var pp CR] >= 0, "#2E8B57", "#D64550")
		lineageTag: E51FB01F-1EB0-4D23-95A3-513DEE000871

	measure 'Color Var Cobertura' = IF([Var pp Cobertura] >= 0, "#2E8B57", "#D64550")
		lineageTag: F88420F3-94D6-4BE8-80CF-55963FA61DB2

	measure 'Color Var WB' = IF([Var % Win back] >= 0, "#2E8B57", "#D64550")
		lineageTag: 8A45DB4F-C428-4C04-8266-EC42760E79D3

	column equipo_serial
		dataType: string
		lineageTag: 205f9a13-de29-451f-a8de-6c15243901c2
		summarizeBy: none
		sourceColumn: equipo_serial

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: dateTime
		formatString: d/mm/yyyy
		lineageTag: 3b1cd98d-1fee-4bea-b116-b038b5d6e233
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column estado_fin_mes
		dataType: string
		lineageTag: cef725b6-cf54-450a-8ecc-043f7bc93318
		summarizeBy: none
		sourceColumn: estado_fin_mes

		annotation SummarizationSetBy = Automatic

	column enContrato = IF( con_equiposContrato[estado_fin_mes]="CONTRATO",1,0)
		formatString: 0
		lineageTag: 1091b1e3-34d9-44d2-bd8a-ea5b6bb250cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column baseCR =
			if(con_equiposContrato[estado_fin_mes]="CONTRATO",1,
			    if(con_equiposContrato[estado_fin_mes]="EVENTO",1,
			    if(con_equiposContrato[estado_fin_mes]="PERCALL",1,
			    0)))
		formatString: 0
		lineageTag: a4ce9ace-4689-46aa-9713-2921d9c41a8c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column estado_mes_anterior
		dataType: string
		lineageTag: f0452535-7891-46db-8262-649d8dc64d70
		summarizeBy: none
		sourceColumn: estado_mes_anterior

		annotation SummarizationSetBy = Automatic

	column paso_garantia_a_contrato
		dataType: int64
		formatString: 0
		lineageTag: f5df6894-00b6-4537-b9e1-4e3e45e7f400
		summarizeBy: sum
		sourceColumn: paso_garantia_a_contrato

		annotation SummarizationSetBy = Automatic

	column paso_percall_evento_a_contrato
		dataType: int64
		formatString: 0
		lineageTag: dfd0a37a-c2a3-4924-adc1-f413f377c361
		summarizeBy: sum
		sourceColumn: paso_percall_evento_a_contrato

		annotation SummarizationSetBy = Automatic

	column metaCR2 = LOOKUPVALUE(Metas[CR Capture Rate], Metas[Clave], con_equiposContrato[ClaveMeta])
		lineageTag: 7eca9871-fd02-4100-98b6-f28a9fbcaacb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column enGarantia = IF( con_equiposContrato[estado_fin_mes]="GARANTIA",1,0)
		formatString: 0
		lineageTag: 864597dc-7b2f-48a5-ac9f-7232ccd00b8e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column enEvento_Percall = ```
			IF( 
			    OR(con_equiposContrato[estado_fin_mes]="EVENTO",
			    con_equiposContrato[estado_fin_mes]="PERCALL"),
			    1,0)
			```
		formatString: 0
		lineageTag: 3af5bd61-12d9-4a51-b58c-44b7b3e160ac
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column enSinClasificar = IF( con_equiposContrato[estado_fin_mes]="SIN CLASIFICAR",1,0)
		formatString: 0
		lineageTag: b7dbb61a-10b3-452e-b4ca-2c95151b17a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MetWC = LOOKUPVALUE(Metas[Warranty Conversion], Metas[Clave], con_equiposContrato[ClaveMeta])
		lineageTag: 79da0dfb-3416-4cd2-a2f0-6231fbf471f1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MetWB = LOOKUPVALUE(Metas[Win Back], Metas[Clave], con_equiposContrato[ClaveMeta])
		lineageTag: 8d3bbe1e-f6e8-44f9-943f-fbd34a4a6211
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column familia
		dataType: string
		lineageTag: 80cb4c19-478f-414e-a3d8-244afd7accf0
		summarizeBy: none
		sourceColumn: familia

		annotation SummarizationSetBy = Automatic

	column CodFam =
			
			SWITCH(
			con_equiposContrato[familia],
			 "DENTAL", "De",
			"DETECTORES", "DR",
			"DIGITAL OUTPUT", "DO",
			"DIGITALIZADORES", "CR",
			"EXTRAORAL", "Ex",
			"INTRAORAL", "In",
			"RAYOS X (XP)", "RX",
			"ULTRASONIDO (US)", "US",
			"MAMOGRAFIA", "MM",
			"OTROS", "Ot",
			"NO APLICA"
			)
		lineageTag: 302dd803-6200-4e4f-8d71-8179f4541652
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cod_familia
		dataType: string
		lineageTag: 5080c945-fda0-4095-8a45-2648e6d5a50d
		summarizeBy: none
		sourceColumn: cod_familia

		annotation SummarizationSetBy = Automatic

	column ClaveMeta = TRIM(con_equiposContrato[familia]) & "|" & YEAR(con_equiposContrato[mes]) & "-" & IF(MONTH(con_equiposContrato[mes])<=6,"H1","H2")
		lineageTag: 070ED7FA-FB81-43B0-BA7B-19DB10F9185F
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition con_equiposContrato = m
		mode: import
		source =
				let
				    Origen = Sql.Database("158.69.115.221:13001", "wh_impulmedicos", [Query="SELECT * FROM v_historicoEstadosEquipos"])
				in
				    Origen

