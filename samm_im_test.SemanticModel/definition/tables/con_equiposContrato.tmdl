	column enContrato = IF( con_equiposContrato[estado_fin_mes]="CONTRATO",1,0)
		formatString: 0
		lineageTag: 1091b1e3-34d9-44d2-bd8a-ea5b6bb250cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column baseCR =
			if(con_equiposContrato[estado_fin_mes]="CONTRATO",1,
			    if(con_equiposContrato[estado_fin_mes]="EVENTO",1,
			    if(con_equiposContrato[estado_fin_mes]="PERCALL",1,
			    0)))
		formatString: 0
		lineageTag: a4ce9ace-4689-46aa-9713-2921d9c41a8c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

